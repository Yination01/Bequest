{
  "appId": "app.bequest.game",
  "appName": "Bequest",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#080c16"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#080c16",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
